<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Material 3 Quiz Activity with elevated card and clean layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">

    <TextView
        android:id="@+id/tv_question_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Câu 1/5"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:textColor="@color/primary"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_generate_quiz"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Tạo Quiz"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:cornerRadius="16dp"
        app:elevation="4dp"
        android:stateListAnimator="@null"
        android:backgroundTint="@color/primary"
        android:layout_marginBottom="16dp"
        android:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_quiz"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tv_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Câu hỏi sẽ hiển thị ở đây"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="28dp" />

                <RadioGroup
                    android:id="@+id/radio_group_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RadioButton
                        android:id="@+id/radio_option_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option A"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:layout_marginBottom="12dp" />

                    <RadioButton
                        android:id="@+id/radio_option_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option B"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:layout_marginBottom="12dp" />

                    <RadioButton
                        android:id="@+id/radio_option_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option C"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:layout_marginBottom="12dp" />

                    <RadioButton
                        android:id="@+id/radio_option_d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option D"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground" />

                </RadioGroup>

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Quay lại"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:cornerRadius="16dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Tiếp theo"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="10dp" />

    </LinearLayout>

</LinearLayout>
