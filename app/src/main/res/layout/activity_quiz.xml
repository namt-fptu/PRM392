<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Material 3 Quiz Activity with elevated card and clean layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header with question number and progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_question_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Câu 1/10"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tv_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/10 câu đã trả lời"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Question Navigation Bar (Sticky) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_question_indicators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:clipToPadding="false" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp"
        android:paddingTop="12dp">

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_quiz"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:text="Tạo Quiz"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@color/primary"
            android:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_quiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            android:visibility="gone">

            <ScrollView
                android:id="@+id/scroll_view_quiz"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:id="@+id/tv_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Câu hỏi sẽ hiển thị ở đây"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="28dp" />

                    <RadioGroup
                        android:id="@+id/radio_group_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/radio_option_a"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option A"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:padding="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:layout_marginBottom="12dp" />

                        <RadioButton
                            android:id="@+id/radio_option_b"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option B"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:padding="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:layout_marginBottom="12dp" />

                        <RadioButton
                            android:id="@+id/radio_option_c"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option C"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:padding="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:layout_marginBottom="12dp" />

                        <RadioButton
                            android:id="@+id/radio_option_d"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Option D"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary"
                            android:padding="16dp"
                            android:background="?attr/selectableItemBackground" />

                    </RadioGroup>

                </LinearLayout>

            </ScrollView>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:paddingTop="12dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Quay lại"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:cornerRadius="16dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Tiếp theo"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="10dp" />

    </LinearLayout>

</LinearLayout>
