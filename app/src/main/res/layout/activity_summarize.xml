<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Material 3 Summarize Activity with cards and actions -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choose_source"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Chọn nguồn tài liệu"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/primary" />

        <!-- Document Title Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Tên tài liệu"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_doc_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_original_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Văn bản gốc"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:drawableStart="@drawable/ic_document"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tv_no_original_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có văn bản. Vui lòng chọn nguồn tài liệu."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="italic"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tv_original_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_primary"
                    android:maxLines="10"
                    android:ellipsize="end"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_summarize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Tóm tắt văn bản"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:enabled="false"
            app:icon="@drawable/ic_summarize"
            app:iconGravity="textStart"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/accent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/primary_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bản tóm tắt"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark"
                    android:drawableStart="@drawable/ic_summary"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/tv_no_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa có bản tóm tắt. Nhấn nút Tóm tắt văn bản."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="italic"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tv_summary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_audio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Tạo audio và lưu"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:enabled="false"
            app:icon="@drawable/ic_audio"
            app:iconGravity="textStart"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/success" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>